# * Galera-related settings
#
# See the examples of server wsrep.cnf files in /usr/share/mariadb
# and read more at https://mariadb.com/kb/en/galera-cluster/

[mysqld]
binlog_format            = row
default_storage_engine   = InnoDB
innodb_autoinc_lock_mode = 2
# bind-address             = 0.0.0.0

[galera]
# Mandatory settings
wsrep_on                 = ON
wsrep_provider           = /usr/lib/galera/libgalera_smm.so
wsrep_cluster_name       = "pga_cluster"
wsrep_cluster_address    = gcomm://192.168.50.11,192.168.50.12,192.168.50.13
wsrep_node_address       = "192.168.50.11"
wsrep_node_name          = "node1"
wsrep_sst_method         = mariabackup
wsrep_sst_auth           = sstuser:changeme
#binlog_format            = row
#default_storage_engine   = InnoDB
#innodb_autoinc_lock_mode = 2

# Allow server to accept connections on all interfaces.
#bind-address = 0.0.0.0

# Optional settings
#wsrep_slave_threads = 1
#innodb_flush_log_at_trx_commit = 0
